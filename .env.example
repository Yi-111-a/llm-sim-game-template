# Default text provider; defaults to Mock when unset.
SIM_PROVIDER=mock
SIM_BASE_URL=https://api.openai.com/v1
SIM_MODEL=gpt-4o-mini
SIM_API_KEY=

# Optional image provider; defaults to Mock.
SIM_IMAGE_PROVIDER=mock
SIM_IMAGE_BASE_URL=https://api.openai.com/v1
SIM_IMAGE_MODEL=gpt-image-1
SIM_IMAGE_API_KEY=

# Optional local data directories.
# LLM_SIM_HOME=
# SIM_SCENARIOS_DIR=
